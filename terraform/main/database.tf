# Private DNS: the app resolves the server name to its private IP inside the VNet.
resource "azurerm_private_dns_zone" "postgres" {
  name                = "${var.project}.private.postgres.database.azure.com"
  resource_group_name = azurerm_resource_group.main.name
  tags                = var.tags
}

resource "azurerm_private_dns_zone_virtual_network_link" "postgres" {
  name                 = "link-${var.project}-vnet"
  private_dns_zone_id  = azurerm_private_dns_zone.postgres.id
  virtual_network_id   = azurerm_virtual_network.main.id
  registration_enabled = false
  tags                 = var.tags
}

# Generated by Terraform, never typed by a human, never stored in git.
# It lives only in the remote state and in the Container App secret.
# special = false keeps it safe inside a connection URL without escaping.
resource "random_password" "postgres" {
  length  = 32
  special = false
}

# STRICTLY the free-tier shape: Burstable B1ms, 32 GB, no HA, no geo backup.
resource "azurerm_postgresql_flexible_server" "main" {
  name                = "psql-${var.project}-${local.suffix}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  version             = "17"

  sku_name          = "B_Standard_B1ms"
  storage_mb        = 32768
  auto_grow_enabled = false

  backup_retention_days        = 7
  geo_redundant_backup_enabled = false
  # No high_availability block = no standby replica (HA would double the price).

  administrator_login    = "blogadmin"
  administrator_password = random_password.postgres.result

  # Private only: injected into the delegated subnet, no public endpoint.
  delegated_subnet_id           = azurerm_subnet.postgres.id
  private_dns_zone_id           = azurerm_private_dns_zone.postgres.id
  public_network_access_enabled = false

  tags = var.tags

  depends_on = [
    azurerm_private_dns_zone_virtual_network_link.postgres,
    azurerm_subnet_network_security_group_association.postgres,
  ]

  lifecycle {
    # We do not pin an availability zone; Azure picks one and must not be
    # asked to move the server on every plan.
    ignore_changes = [zone]
  }
}

# Enhanced metrics (transactions, tuples read, ...) for the database load
# comparison with and without cache in Lab 2. Free, applied without restart.
resource "azurerm_postgresql_flexible_server_configuration" "db_activity_metrics" {
  name      = "metrics.collector_database_activity"
  server_id = azurerm_postgresql_flexible_server.main.id
  value     = "on"
}

resource "azurerm_postgresql_flexible_server_database" "blog" {
  name      = "blog"
  server_id = azurerm_postgresql_flexible_server.main.id
  charset   = "UTF8"
  collation = "en_US.utf8"
}

locals {
  # SSL is enforced by Azure (require_secure_transport = on), hence sslmode=require.
  database_url = format(
    "postgresql+psycopg://%s:%s@%s:5432/%s?sslmode=require",
    azurerm_postgresql_flexible_server.main.administrator_login,
    random_password.postgres.result,
    azurerm_postgresql_flexible_server.main.fqdn,
    azurerm_postgresql_flexible_server_database.blog.name,
  )
}
